<Window x:Class="PixelView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PixelView"
        Title="PixelView" Width="1000" Height="680" MinWidth="1" MinHeight="1"
        WindowStartupLocation="CenterScreen" Background="#151922" Foreground="#EBF0F6"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnKey">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A7B3C8"/>
        <SolidColorBrush x:Key="Accent" Color="#8DE5CE"/>
        <Style x:Key="Tool" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF0F9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="#8DE5CE" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#344154"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#485C73"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconTool" TargetType="Button" BasedOn="{StaticResource Tool}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#364051"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="Toolbar" Background="#222B3B" BorderBrush="#364051" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="MoveFromToolbar">
            <DockPanel LastChildFill="True" Height="51" Margin="10,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Tool}" Background="#29473F" Foreground="{StaticResource Accent}"
                            Click="OpenClick" ToolTip="打开图片 (Ctrl+O)" AutomationProperties.Name="打开图片">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="打开" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Divider}"/>
                    <Button x:Name="PreviousButton" Style="{StaticResource IconTool}" Content="&#xE76B;" Click="PreviousClick"
                            ToolTip="上一张 (←)" AutomationProperties.Name="上一张"/>
                    <Button x:Name="NextButton" Style="{StaticResource IconTool}" Content="&#xE76C;" Click="NextClick"
                            ToolTip="下一张 (→)" AutomationProperties.Name="下一张"/>
                    <Border Style="{StaticResource Divider}"/>
                    <Button x:Name="ZoomOutButton" Style="{StaticResource IconTool}" Content="&#xE71F;" Click="ZoomOutClick"
                            ToolTip="缩小 (-)" AutomationProperties.Name="缩小"/>
                    <Button x:Name="ZoomButton" Style="{StaticResource Tool}" Content="100%" MinWidth="66"
                            Click="ActualClick" ToolTip="实际像素 (1)" AutomationProperties.Name="实际像素"/>
                    <Button x:Name="ZoomInButton" Style="{StaticResource IconTool}" Content="&#xE710;" Click="ZoomInClick"
                            ToolTip="放大 (+)" AutomationProperties.Name="放大"/>
                    <Button x:Name="FitButton" Style="{StaticResource IconTool}" Content="&#xE9A6;" Click="FitClick"
                            ToolTip="适应画布 (0)" AutomationProperties.Name="适应画布"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ViewLockButton" Style="{StaticResource Tool}" Click="ViewLockClick"
                            ToolTip="翻图时保留当前倍率和拖动位置 (Ctrl+K)" AutomationProperties.Name="固定视图">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ViewLockGlyph" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ViewLockText" Text="固定视图"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FullButton" Style="{StaticResource IconTool}" Content="&#xE740;" Click="FullClick"
                            ToolTip="全屏 (F11)" AutomationProperties.Name="全屏"/>
                    <Button x:Name="MenuButton" Style="{StaticResource Tool}" Click="MenuClick" ToolTip="显示与窗口设置"
                            AutomationProperties.Name="显示与窗口设置">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="设置"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Background="Transparent"/>
            </DockPanel>
        </Border>
        <Grid x:Name="Viewport" Grid.Row="1" ClipToBounds="True" MouseMove="ViewportMove" MouseLeave="ViewportLeave">
            <local:ImageSurface x:Name="Surface" Focusable="True" AutomationProperties.Name="图片画布"
                                MouseRightButtonUp="SurfaceMenu" PreviewMouseWheel="WheelZoom"
                                MouseLeftButtonDown="SurfaceDown" MouseLeftButtonUp="SurfaceUp"
                                MouseMove="SurfaceMove" LostMouseCapture="SurfaceLostCapture"/>
            <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                <Border CornerRadius="18" Width="64" Height="64" Background="#233D3B" BorderBrush="#395E57"
                        BorderThickness="1" HorizontalAlignment="Center">
                    <Grid Width="32" Height="32">
                        <Path Fill="#8DE5CE" Data="M 0,0 H 14 V 14 H 0 Z M 18,0 H 32 V 14 H 18 Z M 0,18 H 14 V 32 H 0 Z"/>
                        <Path Fill="#527F79" Data="M 18,18 H 32 V 32 H 18 Z"/>
                    </Grid>
                </Border>
                <TextBlock Text="PixelView" FontSize="32" FontWeight="SemiBold" Foreground="#F0F4FB"
                           Margin="0,16,0,7" HorizontalAlignment="Center"/>
                <TextBlock Text="拖入图片即可查看" Foreground="#BCC9DB" FontSize="15" HorizontalAlignment="Center"/>
                <Button Style="{StaticResource Tool}" Content="打开图片" Background="#29473F"
                        Foreground="{StaticResource Accent}" Click="OpenClick" Margin="0,17,0,0"
                        Padding="24,0" HorizontalAlignment="Center"/>
                <TextBlock Text="滚轮缩放    ·    左键拖图    ·    方向键翻图" Foreground="#A7B3C8"
                           Margin="0,24,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="PreviousOverlay" Style="{StaticResource IconTool}" Content="&#xE76B;"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="42" Height="70" Margin="12,0"
                    Background="#CE222B3B" FontSize="24" Opacity="0" IsHitTestVisible="False" IsTabStop="False" Focusable="False"
                    Click="PreviousClick" ToolTip="上一张 (←)" AutomationProperties.Name="侧边上一张"/>
            <Button x:Name="NextOverlay" Style="{StaticResource IconTool}" Content="&#xE76C;"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="42" Height="70" Margin="12,0"
                    Background="#CE222B3B" FontSize="24" Opacity="0" IsHitTestVisible="False" IsTabStop="False" Focusable="False"
                    Click="NextClick" ToolTip="下一张 (→)" AutomationProperties.Name="侧边下一张"/>
            <Border x:Name="Notice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="#272F40" BorderBrush="#566785" BorderThickness="1" CornerRadius="8"
                    Padding="13,8" Margin="18" MaxWidth="650" IsHitTestVisible="False">
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap"/>
            </Border>
        </Grid>
        <Border x:Name="Status" Grid.Row="2" Background="#222B3B" BorderBrush="#364051" BorderThickness="0,1,0,0">
            <Grid Height="35" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileInfo" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="FrameInfo" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                           Margin="12,0"/>
                <Button x:Name="LockButton" Grid.Column="2" Style="{StaticResource Tool}" Height="27" Click="LockClick"
                        ToolTip="固定或解锁窗口位置和大小 (Ctrl+L)" AutomationProperties.Name="固定窗口">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LockGlyph" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="LockText" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
